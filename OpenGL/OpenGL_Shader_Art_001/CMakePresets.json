{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "MSVC x64 Debug (bundled GLFW /MDd)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "environment": { "CC": "cl", "CXX": "cl", "VSLANG": "1033" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug", "targets": ["all"] }
  ]
}
