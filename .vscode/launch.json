{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OpenGL Basic (MSVC x64 Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/OpenGL/OpenGL_Basic/build/windows-debug/OpenGL_Basic.exe",
      "cwd": "${workspaceFolder}/OpenGL/OpenGL_Basic/build/windows-debug",
      "args": [],
      "preLaunchTask": "Build OpenGL Basic",
      "externalConsole": false
    },
    {
      "name": "OpenGL Shader Art (MSVC x64 Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/OpenGL/OpenGL_Shader_Art_001/build/windows-debug/${input:shaderArt}.exe",
      "cwd": "${workspaceFolder}/OpenGL/OpenGL_Shader_Art_001/build/windows-debug",
      "args": [],
      "preLaunchTask": "Build All OpenGL Artworks",
      "externalConsole": false
    }
  ],
  "inputs": [
    {
      "id": "shaderArt",
      "type": "promptString",
      "description": "실행할 작품 EXE 이름 (예: Art_001, Art_002)",
      "default": "Art_001"
    }
  ]
}
